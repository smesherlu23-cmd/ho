# Настройки Whatever. Скопируйте файл и задайте значения:
#
#     cp .env.example .env
#
# Файл .env в корне репозитория читают и docker compose (на сервере), и бэкенд
# (при разработке). Обязателен только POSTGRES_PASSWORD. Закомментированные строки
# показывают значения по умолчанию: раскомментируйте ту, что нужно изменить.
# Подробное описание каждой настройки — в backend/app/core/config.py.

# ---------- Обязательно ----------

# Пароль базы данных. С ним база создаётся при первом запуске; позже он меняется
# только вместе с паролем пользователя в самой базе (см. docs/operations.md).
POSTGRES_PASSWORD=

# ---------- Публикация ----------

# Порт, на котором приложение доступно на сервере.
# WHATEVER_PORT=8080
# Адрес, на котором сервер принимает соединения к этому порту. 0.0.0.0 — все адреса.
# 127.0.0.1, если перед приложением стоит прокси с TLS на этом же сервере: тогда порт
# не открыт наружу. Порты Docker обходят ufw, поэтому закрыть его файрволом не выйдет.
# WHATEVER_BIND_ADDRESS=0.0.0.0
# true, если приложение открывают по HTTPS (TLS на внешнем прокси):
# cookie сессии не уйдёт по открытому каналу.
# WHATEVER_COOKIE_SECURE=false
# Адрес или подсеть внешнего прокси (TLS), если он стоит перед приложением: nginx возьмёт
# адрес пользователя из его X-Forwarded-For. Для прокси на том же сервере — подсеть Docker,
# например 172.16.0.0/12 (см. docs/operations.md).
# WHATEVER_TRUSTED_PROXY=127.0.0.1
# Прокси, которым бэкенд верит в заголовке X-Forwarded-For. В docker compose
# по умолчанию «*»: бэкенд доступен только из nginx внутри сети compose.
# WHATEVER_FORWARDED_ALLOW_IPS=127.0.0.1

# ---------- Образы ----------

# Готовые образы релиза вместо сборки на сервере (docs/operations.md, «Обновление»):
# WHATEVER_IMAGE_PREFIX=ghcr.io/smesherlu23-cmd/whatever и версия из CHANGELOG.md.
# Без них образы собираются на сервере из исходников (whatever-backend:dev).
# WHATEVER_IMAGE_PREFIX=whatever
# WHATEVER_VERSION=dev

# ---------- База данных ----------

# В docker compose бэкенд подключается к сервису postgres сам. Эти строки нужны,
# когда бэкенд запущен вне Docker (разработка) или база стоит на отдельном сервере.
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=whatever
# POSTGRES_DB=whatever
# Постоянные соединения бэкенда с базой и сколько временных можно открыть сверх них.
# WHATEVER_DB_POOL_SIZE=5
# WHATEVER_DB_MAX_OVERFLOW=10

# ---------- Вход ----------

# Сколько дней действует вход без повторного ввода пароля.
# WHATEVER_SESSION_TTL_DAYS=30
# После стольких неудачных попыток входа за окно (в минутах) вход временно закрыт.
# WHATEVER_LOGIN_MAX_FAILURES=5
# Неудачных попыток с одного адреса по любым логинам за то же окно.
# WHATEVER_LOGIN_MAX_FAILURES_PER_ADDRESS=30
# WHATEVER_LOGIN_WINDOW_MINUTES=15

# ---------- Синхронизация досок ----------

# Изменения доски за это время (в секундах) пишутся в базу одной строкой.
# WHATEVER_SYNC_SAVE_DELAY_SECONDS=0.5
# Сколько записей истории доски копить, прежде чем сжать их в один снимок.
# WHATEVER_SYNC_COMPACT_AFTER=50

# ---------- История версий ----------

# Пока доску меняют, её версия сохраняется сама раз в столько минут, а ещё когда все
# участники с неё ушли.
# WHATEVER_VERSION_INTERVAL_MINUTES=10
# Сколько дней хранятся автоматические версии. Названные хранятся, пока их не удалят.
# WHATEVER_VERSION_RETENTION_DAYS=30

# ---------- Файлы ----------

# Каталог, где хранятся картинки и вложения досок. В docker compose это том files-data:
# путь задан в docker-compose.yml, а том нужно копировать вместе с базой (docs/operations.md).
# WHATEVER_FILES_DIR=data/files
# Наибольший размер одного файла, загружаемого на доску, в мегабайтах.
# WHATEVER_MAX_UPLOAD_MB=10
# Сколько мегабайт файлов можно загрузить на одну доску.
# WHATEVER_MAX_BOARD_FILES_MB=1024

# ---------- Резервные копии ----------

# Сервис backup каждый день копирует базу и файлы досок (docs/operations.md).
# Папка копий на сервере. Храните копии и на другом сервере.
# WHATEVER_BACKUP_DIR=./backups
# В котором часу по UTC делать копию (0 — 3:00 по Москве).
# WHATEVER_BACKUP_HOUR=0
# Сколько дней хранить копии.
# WHATEVER_BACKUP_KEEP_DAYS=14

# ---------- Наблюдение ----------

# Токен, с которым Prometheus читает показатели с /api/metrics (Authorization: Bearer ...).
# Пусто — показатели не отдаются. Длинная случайная строка: openssl rand -hex 32
# WHATEVER_METRICS_TOKEN=

# ---------- Журнал ----------

# DEBUG, INFO, WARNING или ERROR.
# WHATEVER_LOG_LEVEL=INFO
# text — для чтения глазами, json — для сборщиков журналов (Loki, ELK, Vector).
# WHATEVER_LOG_FORMAT=text
